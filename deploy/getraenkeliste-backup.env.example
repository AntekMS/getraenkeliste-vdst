# Konfiguration für scripts/backup.sh (systemd: getraenkeliste-backup.service).
#
# Installation:
#   sudo cp deploy/getraenkeliste-backup.env.example /etc/getraenkeliste-backup.env
#   sudo chmod 600 /etc/getraenkeliste-backup.env   # enthält das DB-Passwort!
#   sudo nano /etc/getraenkeliste-backup.env         # DB_PASS eintragen
#
# Format: KEY=wert, ohne Leerzeichen um "=" (systemd-EnvironmentFile).

# Pflicht: gleicher Wert wie DB_PASS in /opt/getraenkeliste/.env
DB_PASS=HIER_DB_PASSWORT_EINTRAGEN

# Optional (Defaults stehen dahinter):
#BACKUP_DIR=/mnt/kasse-backup/getraenkeliste
#BACKUP_MOUNT=/mnt/kasse-backup
#DB_CONTAINER=getraenkeliste-db
#DB_NAME=getraenkeliste
#DB_USER=getraenkeuser
#RETENTION_DAILY=30
#RETENTION_MONTHLY_TAGE=366
